{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.anivdel/coolftp",
  "description": "Deploy a site to its SFTP/FTP host from a coding agent. Changed files only, undo, live checks.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/anivdel/coolFTP",
    "source": "github"
  },
  "websiteUrl": "https://coolftp.com",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "coolftp",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the MCP server over stdio"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
