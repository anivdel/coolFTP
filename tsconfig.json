{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@coolftp/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.mjs"]
}
