{
  "name": "coolftp-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "coolFTP - a desktop SFTP/FTP app that coding agents can drive",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/app"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "app": "npm run build && electron packages/app",
    "cli": "node packages/cli/dist/coolftp.js",
    "dist": "npm run build && electron-builder --config packages/app/electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node scripts/e2e.cjs",
    "dev:ftp": "node scripts/dev-ftp-server.cjs",
    "dev:sftp": "node scripts/lib/sftp-server.cjs",
    "demo": "electron scripts/demo/render.cjs",
    "demo:voice": "node scripts/demo/narrate.cjs",
    "social": "electron scripts/social/render.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "ffmpeg-static": "^5.3.0",
    "ftp-srv": "^4.6.3",
    "msedge-tts": "^2.0.7",
    "typescript": "^5.5.0"
  }
}
